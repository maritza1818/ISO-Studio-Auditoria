# Pega exactamente la Chat URL de producción del nodo "When chat message received" de n8n.
# El flujo debe estar publicado y el Chat Trigger en modo Embedded Chat.
# Ejemplo de estructura (NO es una URL válida real):
# N8N_CHAT_URL=http://127.0.0.1:5678/webhook/IDENTIFICADOR/chat
N8N_CHAT_URL=
PORT=4317

# Habilita la busqueda real por Internet. Obtiene tu clave en https://app.tavily.com
# No compartas la clave ni subas el archivo .env a GitHub.
TAVILY_API_KEY=
# Proteccion de la cuota en el backend (busquedas que NO salen de cache por hora)
WEB_SEARCH_MAX_PER_HOUR=36

# Módulo Visual. Por defecto solo simula y no genera imágenes IA.
VISUAL_PROVIDER=mock
# Para generación real configura openai, una API Key distinta de Gemini y un código privado >=12 caracteres.
VISUAL_OPENAI_API_KEY=
VISUAL_IMAGE_MODEL=gpt-image-1
VISUAL_ACCESS_CODE=
VISUAL_MAX_PER_HOUR=8

# ISO Studio 6: análisis visual y OCR
# OCR local de imagen/PDF escaneado: no requiere API, pero puede descargar datos de idioma la primera vez.
GEMINI_VISION_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
VISION_MAX_PER_HOUR=8

# El agente permanece bloqueado hasta revisar n8n y RAG (ver guía).
SCOPE_N8N_REVIEWED=false
